---
import { portfolios } from "../data/portfolio.js";
---

<section class="portfolios container" aria-labelledby="portfolios-heading">
  <h2 id="portfolios-heading">Portfolios</h2>
  <ul>
    {
      portfolios.map((portfolio, i) => {
        const cover = portfolio.cover ?? portfolio.projects?.[0]?.image;
        const count = portfolio.projects?.length ?? 0;
        return (
          <li>
            <a class="portfolio-link" href={`/${portfolio.slug}/`}>
              <div class="media">
                {cover && (
                  <img
                    src={cover}
                    alt=""
                    width="800"
                    height="1000"
                    loading={i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </div>
              <div class="text">
                <h3>{portfolio.title}</h3>
                {portfolio.description && <p class="description">{portfolio.description}</p>}
                <p class="meta">
                  {count} {count === 1 ? "work" : "works"}
                  <span class="arrow" aria-hidden="true">→</span>
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .portfolios {
    padding-block: var(--space-6) var(--space-8);
  }

  h2 {
    padding-top: var(--space-5);
    margin-bottom: var(--space-6);
    border-top: 1px solid var(--color-text);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile: compact rows with a thumbnail. */
  .portfolio-link {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .portfolio-link:hover {
    border-color: var(--color-text);
    background: var(--color-surface);
  }

  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .text {
    display: grid;
    gap: var(--space-1);
  }

  h3 {
    font-size: 1.375rem;
  }

  .description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .arrow {
    font-size: 1rem;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .portfolio-link:hover .arrow {
    transform: translateX(4px);
  }

  /* Wider screens: three large cover cards. */
  @media (min-width: 720px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .portfolio-link {
      grid-template-columns: 1fr;
      align-items: start;
      height: 100%;
      padding: 0;
      border: 0;
      gap: var(--space-4);
    }

    .portfolio-link:hover {
      background: none;
    }

    .media {
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-md);
    }

    .portfolio-link:hover img {
      transform: scale(1.03);
    }

    h3 {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
    }
  }
</style>
