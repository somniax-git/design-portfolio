---
const { project, eager = false } = Astro.props;
const meta = [project.category, project.year].filter(Boolean).join(" · ");
const Tag = project.url ? "a" : "div";
---

<article class="card">
  <Tag class="card-link" href={project.url}>
    <div class="media">
      <span class="fallback" aria-hidden="true">{project.title}</span>
      <img
        src={project.image}
        alt={project.alt}
        width="800"
        height="1000"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        onerror="this.remove()"
      />
      {project.placeholder && <span class="badge">Placeholder</span>}
    </div>
    <div class="text">
      <h2>{project.title}</h2>
      {meta && <p class="meta">{meta}</p>}
      {project.description && <p class="description">{project.description}</p>}
    </div>
  </Tag>
</article>

<style>
  .card-link {
    display: grid;
    gap: var(--space-3);
    height: 100%;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .card-link:focus-visible {
    outline-offset: 6px;
  }

  .media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Visible only if the image is missing or fails to load. */
  .fallback {
    padding: var(--space-4);
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .text {
    display: grid;
    gap: var(--space-1);
  }

  h2 {
    font-size: 1.375rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s ease;
  }

  .meta {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  a.card-link:hover img {
    transform: scale(1.03);
  }

  a.card-link:hover h2,
  a.card-link:focus-visible h2 {
    text-decoration-color: currentColor;
  }
</style>
